{
  "name": "@logiclab/logic-engine",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proof": {
      "types": "./dist/proof/index.d.ts",
      "default": "./dist/proof/index.js"
    },
    "./proof/rules": {
      "types": "./dist/proof/rule-catalog.d.ts",
      "default": "./dist/proof/rule-catalog.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w @logiclab/contracts",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@logiclab/contracts": "*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0"
  }
}
