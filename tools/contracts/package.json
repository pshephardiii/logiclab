{
  "name": "@logiclab/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "browser": "dist/browser/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.js",
      "default": "./dist/index.js"
    },
    "./derivation": {
      "types": "./dist/derivation.d.ts",
      "browser": "./dist/browser/derivation.js",
      "default": "./dist/derivation.js"
    },
    "./problem-library": {
      "types": "./dist/problem-library.d.ts",
      "browser": "./dist/browser/problem-library.js",
      "default": "./dist/problem-library.js"
    },
    "./derivation-work": {
      "types": "./dist/derivation-work.d.ts",
      "browser": "./dist/browser/derivation-work.js",
      "default": "./dist/derivation-work.js"
    },
    "./saved-student-work": {
      "types": "./dist/saved-student-work.d.ts",
      "browser": "./dist/browser/saved-student-work.js",
      "default": "./dist/saved-student-work.js"
    },
    "./proof-submission": {
      "types": "./dist/proof-submission.d.ts",
      "browser": "./dist/browser/proof-submission.js",
      "default": "./dist/proof-submission.js"
    },
    "./dependency-derivation": {
      "types": "./dist/dependency-derivation.d.ts",
      "browser": "./dist/browser/dependency-derivation.js",
      "default": "./dist/dependency-derivation.js"
    },
    "./dependency-derivation-work": {
      "types": "./dist/dependency-derivation-work.d.ts",
      "browser": "./dist/browser/dependency-derivation-work.js",
      "default": "./dist/dependency-derivation-work.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.browser.json",
    "dev": "concurrently -k -n node,browser \"tsc --watch\" \"tsc -p tsconfig.browser.json --watch\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.0"
  }
}
