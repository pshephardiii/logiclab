{
  "name": "@logiclab/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "generate": "node --env-file-if-exists=../../.env --import tsx ../../node_modules/@mikro-orm/cli/cli.js migration:create --config mikro-orm.config.ts",
    "migrate": "node --env-file-if-exists=../../.env --import tsx ../../node_modules/@mikro-orm/cli/cli.js migration:up --config mikro-orm.config.ts",
    "test:integration": "node --env-file-if-exists=../../.env --import tsx --test test/database.test.ts",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/decorators": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.5",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0"
  },
  "type": "module"
}
