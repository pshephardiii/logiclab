# Local Docker development only. Keep DATABASE_URL aligned with password/port below.
POSTGRES_PASSWORD=logiclab_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://logiclab:logiclab_local@127.0.0.1:5432/logiclab
# Integration tests require a separate disposable database, never application data.
# TEST_DATABASE_URL=postgresql://logiclab:logiclab_local@127.0.0.1:5432/logiclab_test

# Auth HTTP routes. Enable after AWS provisioning and local migrations.
AUTH_ENABLED=false
AWS_REGION=us-east-1
APP_ORIGIN=http://localhost:5173
COGNITO_USER_POOL_ID=us-east-1_REPLACE_ME
COGNITO_CLIENT_ID=REPLACE_ME
COGNITO_CLIENT_SECRET=REPLACE_ME
AUTH_TOKEN_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Backend authentication; replace placeholders before enabling.
AWS_PROFILE=logiclab-dev

# Simulator foundation only; HTTP/bootstrap wiring is a later billing slice.
BILLING_ENABLED=false
BILLING_SIMULATOR_SIGNING_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
