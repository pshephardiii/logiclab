# Build-time API origin; omit when /api is routed on the same origin.
# VITE_API_URL=https://api.example.com

# Local serving defaults to full. Every production build requires an explicit choice.
# Must match the API PRODUCT_EXPOSURE setting; disagreement blocks application startup.
# VITE_PRODUCT_EXPOSURE=full
# Initial hosted practice sandbox: VITE_PRODUCT_EXPOSURE=practice-only
